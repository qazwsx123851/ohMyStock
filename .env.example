# ohMyStock environment variables — placeholder template.
# Copy to `.env` and fill in real values. `.env` is git-ignored; do NOT commit secrets.
# Authoritative references:
#   - docs/safety-and-simulation.md §2.9  (OHMYSTOCK_AUTO_EXECUTE breaker)
#   - docs/v3-decisions.md §3 #15         (OHMYSTOCK_LLM_DEGRADE soft breaker)
#   - docs/design-zh-TW.md §4.11.2        (Shioaji authentication fields)
#   - docs/design-zh-TW.md §5.1           (FinMind token)

# --- Anthropic Claude API ---
ANTHROPIC_API_KEY=

# --- Shioaji (Sinopac paper-trading account) ---
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_CA_PATH=
SHIOAJI_CA_PASSWD=
SHIOAJI_PERSON_ID=

# --- FinMind (sponsored member) ---
FINMIND_TOKEN=

# --- ohMyStock runtime toggles ---
# v1 default: false — Confirm Gate requires manual approval per safety §2.9.
OHMYSTOCK_AUTO_EXECUTE=false
# Set to true to fall back to all-Sonnet routing when monthly LLM cost > USD $50 (v3-decisions #15).
OHMYSTOCK_LLM_DEGRADE=false
# SQLite path for trade journal + memory + FTS5 index.
OHMYSTOCK_DB_PATH=~/.ohmystock/journal.db
# Logging verbosity: DEBUG | INFO | WARNING | ERROR.
OHMYSTOCK_LOG_LEVEL=INFO

# --- Phase 3 LLM Decider PM node ---
# Model used by `ohmystock decide`. Default is opus for production; override
# to claude-sonnet-4-6 / claude-haiku-4-5 for cheaper dev runs.
OHMYSTOCK_DECIDER_MODEL=claude-opus-4-7
# Set to true ONLY in tests to allow `fake://...` decider models. Production
# refuses and exits 4.
OHMYSTOCK_ALLOW_FAKE_DECIDER=false

# --- Confirm Gate v0 ---
# Pending entry timeout in minutes (sweep_expired uses this). v3-decisions #11
# pinned 30 minutes.
OHMYSTOCK_CONFIRM_TIMEOUT_MINUTES=30
# Capital (TWD) used by Confirm Gate to compute qty from final_sizing_pct.
# Replaced by Sizing Service in a future change.
OHMYSTOCK_DEFAULT_CAPITAL_TWD=1000000
